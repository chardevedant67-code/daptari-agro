NODE_ENV=
PORT=
MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=
JWT_EXPIRE_LONG=
SERVER_IP=
ALLOWED_ORIGINS=

# Public base URL encoded into every QR code, e.g. https://your-backend.onrender.com
# (no trailing slash). Required in production — QR generation fails with a
# clear error instead of falling back to a LAN IP if this is unset. Optional
# in local development, where SERVER_IP+PORT (or localhost) is still used.
PUBLIC_BASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bootstrap credentials for `npm run seed` (server/seeder.js) — only used
# when that script is run manually; required, no hardcoded fallback.
SEEDER_ADMIN_EMAIL=
SEEDER_ADMIN_PASSWORD=
SEEDER_OPERATOR_EMAIL=
SEEDER_OPERATOR_PASSWORD=

# Target account + new password for `node reset-admin.js`, run manually;
# required, no hardcoded fallback. Which account gets reset is controlled
# entirely by these — never assume a default identity.
RESET_ADMIN_EMAIL=
RESET_ADMIN_PASSWORD=
RESET_OPERATOR_EMAIL=
RESET_OPERATOR_PASSWORD=

# Admin frontend's deployed public origin (e.g. https://your-admin.example.com,
# no trailing slash) — used ONLY to build Admin password-reset links
# (${APP_PUBLIC_URL}/reset-password?token=...). Distinct from PUBLIC_BASE_URL
# above, which is for QR codes only — never reused for this. Required in
# production; if unset, forgot-password requests fail safely (no token is
# generated/emailed, generic response is still returned, error is logged
# server-side only). Never a localhost/LAN fallback.
APP_PUBLIC_URL=

# Resend (https://resend.com) — used ONLY to send the Admin password-reset
# email. Required for that email to actually send; if unset, forgot-password
# still returns its generic response but no email goes out (logged
# server-side only, never a hard failure to the client).
RESEND_API_KEY=
EMAIL_FROM=
