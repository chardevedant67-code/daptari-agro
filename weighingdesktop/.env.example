# Copy to `.env` (same folder) to override the defaults. Environment
# variables of the same name take precedence over this file.

# Backend origin (no trailing slash, no /api suffix).
# Leave unset for local development — falls back to http://localhost:5001.
DESKTOP_API_URL=

# Folder that receives Seed_Management.xlsx. Leave unset to use Documents.
DESKTOP_WORKBOOK_DIR=

# Folder for the app's own state (signed-in session, record cache, unsent
# changes). Leave unset to use the standard per-user application folder.
DESKTOP_USER_DATA_DIR=
